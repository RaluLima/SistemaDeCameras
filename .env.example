DATABASE_URL="postgresql://postgres:postgres@localhost:5432/camera_monitor?schema=public"

NEXTAUTH_SECRET="gerar-um-segredo-aqui"
NEXTAUTH_URL="http://localhost:3000"

# URL do serviço de IA Python (opcional)
# NEXT_PUBLIC_AI_SERVICE_URL="http://localhost:8000"

# URL base do servidor HLS/MediaMTX (opcional, para streaming ao vivo)
# LIVE_BASE_URL="http://localhost:8888"

# Chaves de serviço para comunicação interna (opcional)
# AI_SERVICE_KEY="sua-chave-ai"
# RECORDING_SERVICE_KEY="sua-chave-recorder"

# Chaves JWT para autenticação de serviços (opcional)
# AUTH_SECRET="seu-secret-jwt"

# Opcional — login com Google
# GOOGLE_CLIENT_ID="seu-client-id"
# GOOGLE_CLIENT_SECRET="seu-client-secret"

# Diretório de gravações (opcional, padrão: ./recordings)
# RECORDINGS_DIR="./recordings"
